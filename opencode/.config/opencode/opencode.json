{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "ask",
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "rm -rf *": "deny",
      "sudo *": "deny",
      "curl * | *": "deny"
    },
    "edit": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "id_rsa*": "deny",
      "id_ed25519*": "deny",
      ".ssh/**": "deny",
      ".aws/**": "deny",
      ".gnupg/**": "deny"
    },
    "external_directory": {
      "*": "deny",
    },
    "webfetch": "ask"
  },
  "provider": {
    "deepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek",
      "options": {
        "baseURL": "https://api.deepseek.com/v1",
      },
      "models": {
        "deepseek-v4-flash": { "name": "DeepSeek V4 Flash" },
        "deepseek-v4-pro": { "name": "DeepSeek V4 Pro", "reasoning": true }
      }
    }
  }
}
