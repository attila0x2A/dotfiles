{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-v4-pro",
  "small_model": "google/gemini-3.5-flash",
  "autoupdate": false,
  "logLevel": "INFO",
  "compaction": {
    "auto": true,
    "tail_turns": 10,
    "reserved": 5000,
    "prune": true
  },
  "permission": {
    "*": "ask",
    "question": "allow",
    "todowrite": "allow",
    "websearch": "allow",
    "skill": "allow",
    "glob": "allow",
    "ls": "allow",
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "rm -rf *": "deny",
      "sudo *": "deny",
      "curl * | *": "deny",
      "git push*": "deny"
    },
    "edit": "ask",
    "write": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "id_rsa*": "deny",
      "id_ed25519*": "deny",
      ".ssh/**": "deny",
      ".aws/**": "deny",
      ".gnupg/**": "deny",
      "**/secrets/**": "deny",
      "**/credentials/**": "deny",
      ".netrc": "deny",
      ".git-credentials": "deny",
      ".git/config": "deny"
    },
    "external_directory": {
      "/tmp/opencode/**": "allow",
      "*": "deny"
    },
    "webfetch": "ask"
  },
  "provider": {
    "deepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek",
      "options": {
        "baseURL": "https://api.deepseek.com/v1",
      },
      "models": {
        "deepseek-v4-flash": { "name": "DeepSeek V4 Flash" },
        "deepseek-v4-pro": { "name": "DeepSeek V4 Pro", "reasoning": true }
      }
    },
    "google": {},
    "anthropic": {}
  }
}
