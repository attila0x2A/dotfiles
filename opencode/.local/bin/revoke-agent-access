#!/usr/bin/env bash
set -euo pipefail

AGENT_USER="aiagent"

if [ $# -lt 1 ] || [ -z "$1" ]; then
    echo "Error: Target directory argument is required." >&2
    echo "Usage: $0 <target_directory>" >&2
    exit 1
fi
TARGET_DIR="$1"

if [ ! -d "$TARGET_DIR" ]; then
    echo "Error: Directory '$TARGET_DIR' does not exist." >&2
    exit 1
fi

WORKDIR="$(realpath "$TARGET_DIR")"
echo "Revoking $AGENT_USER access from $WORKDIR..."

getfacl -R -P -p -E "$WORKDIR" 2>/dev/null | awk -v agent="$AGENT_USER" '
  /^user:/   { if ($0 ~ ("^user:" agent ":")) next }
  /^default:user:/ { if ($0 ~ ("^default:user:" agent ":")) next }
  /^mask::/ { next }
  /^default:mask::/ { next }
  { print }
' | setfacl --restore=- -P
