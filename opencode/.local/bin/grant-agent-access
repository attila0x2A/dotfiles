#!/usr/bin/env bash
set -euo pipefail

AGENT_USER="aiagent"

if [ $# -lt 1 ] || [ -z "$1" ]; then
    echo "Error: Target directory argument is required." >&2
    echo "Usage: $0 <target_directory>" >&2
    exit 1
fi
TARGET_DIR="$1"

if [ ! -d "$TARGET_DIR" ]; then
    echo "Error: Directory '$TARGET_DIR' does not exist." >&2
    exit 1
fi

WORKDIR="$(realpath "$TARGET_DIR")"
echo "Granting $AGENT_USER access to $WORKDIR (mirroring owner permissions)..."

# default:user:: permissions are added to make sure that user keeps access
# to the files created by the agent. Applied to all subdirectories, not just
# the top-level WORKDIR.
# TODO: Ideally this should be more robust: if default users permissions exist somewhere they should be kept the same.
find "$WORKDIR" -type d -print0 2>/dev/null | while IFS= read -r -d '' dir; do
    getfacl -P -p -E "$dir" 2>/dev/null | awk '
      /^user::/ {
        n = split($0, a, ":")
        p = a[3]
        print
        printf "default:user::%s\n", p
        next
      }
      { print }
    ' | setfacl --restore=- -P
done

# Similarly default:user:agent are added so that agent has access to newly
# created files.
getfacl -R -P -p -E "$WORKDIR" 2>/dev/null | awk -v agent="$AGENT_USER" '
  /^user::/ {
    n = split($0, a, ":")
    p = a[3]
    print
    printf "user:%s:%s\n", agent, p
    next
  }
  /^default:user::/ {
    n = split($0, a, ":")
    p = a[4]
    print
    printf "default:user:%s:%s\n", agent, p
    next
  }
  { print }
' | setfacl --restore=- -P
