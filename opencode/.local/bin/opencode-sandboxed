#!/usr/bin/env bash
set -euo pipefail

AGENT_USER="aiagent"
SANDBOX_CFG="$HOME/.config/opencode-sandbox"
IMAGE="opencode-sandbox"
PROXY_NAME="opencode-egress-proxy"
NETWORK="opencode-net"
OC_DATA="$SANDBOX_CFG/data"

runas() {
  sudo -u "$AGENT_USER" env XDG_RUNTIME_DIR="/run/user/$(id -u "$AGENT_USER")" "$@"
}

# Safely quote user args to prevent injection into inner bash
OC_ARGS=""
if [ $# -gt 0 ]; then
  printf -v OC_ARGS '%q ' "$@"
  OC_ARGS="${OC_ARGS% }"
fi

runas mkdir -p "$OC_DATA"
runas podman network exists "$NETWORK" 2>/dev/null || runas podman network create "$NETWORK"
runas podman start "$PROXY_NAME" 2>/dev/null || runas podman run -d \
  --name "$PROXY_NAME" --network "$NETWORK" \
  -v "$SANDBOX_CFG/squid.conf:/etc/squid/squid.conf:ro" \
  docker.io/ubuntu/squid

runas bash -c "
  DEEPSEEK_API_KEY=\$(pass show deepseek/opencode-api-key)
  GOOGLE_GENERATIVE_AI_API_KEY=\$(pass show google/gemini-api-key)
  podman run --rm -it \
    --userns=keep-id \
    --network '$NETWORK' \
    --cap-drop=ALL \
    --security-opt no-new-privileges \
    --memory=4g --cpus=2 --pids-limit=512 \
    --read-only \
    --mount type=tmpfs,target=/tmp,U=true \
    --mount type=tmpfs,target=/home/${AGENT_USER},U=true \
    -e HTTPS_PROXY=http://$PROXY_NAME:3128 \
    -e HTTP_PROXY=http://$PROXY_NAME:3128 \
    -e NO_PROXY=localhost,127.0.0.1 \
    -e OPENCODE_ENABLE_EXA=1 \
    -e DEEPSEEK_API_KEY="\${DEEPSEEK_API_KEY}" \
    -e GOOGLE_GENERATIVE_AI_API_KEY="\${GOOGLE_GENERATIVE_AI_API_KEY}" \
    -e XDG_STATE_HOME=/tmp/opencode-state \
    -e XDG_CONFIG_HOME=/home/${AGENT_USER}/.config \
    -e XDG_CACHE_HOME=/tmp/opencode-cache \
    -v '$PWD':/workspace \
    -v '$HOME/.config/opencode/opencode.json:/home/${AGENT_USER}/.config/opencode/opencode.json:ro' \
    -v '$HOME/.config/opencode/instructions.md:/home/${AGENT_USER}/.config/opencode/instructions.md:ro' \
    -v '$OC_DATA:/home/${AGENT_USER}/.local/share/opencode' \
    '$IMAGE' ${OC_ARGS:+ }${OC_ARGS}
"
